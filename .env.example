# Copy to .env for local development. In Docker/Unraid these are container env vars.
PORT=3000
TZ=America/New_York
# Eyebrow above the greeting, and the name in the greeting
SERVER_NAME=Apollo Media
USER_NAME=Christopher

# Where the setup wizard saves settings (settings.json). Saved settings override the env vars below.
DATA_DIR=./data
# --- Everything below is optional: the setup wizard in the app is the normal way to set these. ---

# Poll interval (seconds) used by the browser for "Now Playing"
REFRESH_SECONDS=15
# Starting size of the Recently Added row (change it later in Settings)
RECENT_LIMIT=15

# --- Media servers (configure one or both) ---
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=
# Optional: a Jellyfin user id. When set, "Recently Added" uses that user's
# library view (grouped by series) instead of the raw item list.
JELLYFIN_USER_ID=

# --- Calendar ---
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=

# --- Requests (Overseerr or Jellyseerr) ---
SEERR_URL=http://192.168.1.10:5055
SEERR_API_KEY=
# Optional: make requests on behalf of this Seerr user id instead of the API key owner
SEERR_USER_ID=
